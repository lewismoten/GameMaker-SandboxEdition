    {
      "kind": "hintbook",
      "title": "Maximus Hint Book",
      "note": "Answers hidden: use the red film",
      "promised": true,
      "intro": "Find your question, then slide the red film over the answer under it. Read one answer at a time: a courier who knows everything has nothing left to find.",
      "sections": [
        {
          "head": "First Steps",
          "hints": [
            {
              "q": "How do I get off the training deck?",
              "a": "Pay the credit door with the credits you pick up, ride the lift, and walk into the airlock. The pod is waiting."
            },
            {
              "q": "How do I land on a planet?",
              "a": "Fly the pod into the middle of the planet on the sector chart."
            },
            {
              "q": "How do I get back to space?",
              "a": "Walk into the uplink beacon behind you where you landed. On sea worlds, surface at the buoy."
            },
            {
              "q": "I keep running out of lives.",
              "a": "Buy an extra life at the trading post for 100 credits, and save with F5 before every vault."
            }
          ]
        },
        {
          "head": "The Star-Shards",
          "hints": [
            {
              "q": "Where is the Ruby shard?",
              "a": "Ambermoor, in The Cradle. Look for the gold signal on the sector chart, then use the long-range scan on the planet card to find the vault."
            },
            {
              "q": "Where is the Amber shard?",
              "a": "Brightwater, in The Cradle. Look for the gold signal on the sector chart, then use the long-range scan on the planet card to find the vault."
            },
            {
              "q": "Where is the Citrine shard?",
              "a": "Cinderfall, in Emberreach. Look for the gold signal on the sector chart, then use the long-range scan on the planet card to find the vault."
            },
            {
              "q": "Where is the Emerald shard?",
              "a": "Hot Springs, in Emberreach. Look for the gold signal on the sector chart, then use the long-range scan on the planet card to find the vault."
            },
            {
              "q": "Where is the Jade shard?",
              "a": "Pearlbed, in The Shallows. Look for the gold signal on the sector chart, then use the long-range scan on the planet card to find the vault."
            },
            {
              "q": "Where is the Aqua shard?",
              "a": "Mushroom Moon, in The Shallows. Look for the gold signal on the sector chart, then use the long-range scan on the planet card to find the vault."
            },
            {
              "q": "Where is the Sapphire shard?",
              "a": "Prism, in Glasswind. Look for the gold signal on the sector chart, then use the long-range scan on the planet card to find the vault."
            },
            {
              "q": "Where is the Amethyst shard?",
              "a": "Glass Abyss, in Glasswind. Look for the gold signal on the sector chart, then use the long-range scan on the planet card to find the vault."
            },
            {
              "q": "Where is the Rose shard?",
              "a": "Hollow Sun, in The Deep Black. Look for the gold signal on the sector chart, then use the long-range scan on the planet card to find the vault."
            },
            {
              "q": "Where is the Pearl shard?",
              "a": "Ghost Station, in The Deep Black. Look for the gold signal on the sector chart, then use the long-range scan on the planet card to find the vault."
            }
          ]
        },
        {
          "head": "Courier Modules",
          "hints": [
            {
              "q": "Where do I find the Plasma Lance?",
              "a": "In a vault on Little Hollow, in The Cradle. Press P to pick it up; its key is Z."
            },
            {
              "q": "Where do I find the Nova Core?",
              "a": "In a vault on Pyre, in Emberreach. Press P to pick it up; its key is X."
            },
            {
              "q": "Where do I find the Dash Boots?",
              "a": "In a vault on Copperfield, in The Cradle. Press P to pick it up; its key is Q / E."
            },
            {
              "q": "Where do I find the Shield Emitter?",
              "a": "In a vault on Mistral Isle, in The Shallows. Press P to pick it up; its key is C."
            },
            {
              "q": "Where do I find the Hover Pack?",
              "a": "In a vault on Scorchmark, in Emberreach. Press P to pick it up; its key is F."
            },
            {
              "q": "Where do I find the Mine Layer?",
              "a": "In a vault on Rimefall, in Glasswind. Press P to pick it up; its key is V."
            },
            {
              "q": "Where do I find the Med Kit?",
              "a": "In a vault on Outpost Nine, in The Cradle. Press P to pick it up; its key is H."
            },
            {
              "q": "Where do I find the Flak Cannon?",
              "a": "In a vault on Venom Marsh, in Glasswind. Press P to pick it up; its key is W."
            },
            {
              "q": "Where do I find the Hydro Jets?",
              "a": "In a vault on Tidewater, in The Shallows. Press P to pick it up; its key is Q / E (sub)."
            },
            {
              "q": "Where do I find the Spring Shocks?",
              "a": "In a vault on Redrock, in Emberreach. Press P to pick it up; its key is Up (rover)."
            }
          ]
        },
        {
          "head": "Getting Unstuck",
          "hints": [
            {
              "q": "My blaster bounces off a creature.",
              "a": "It is armored, like an Ironback or a Gun Turret. Only the Plasma Lance (Z) cracks armor."
            },
            {
              "q": "The rover cannot climb a ledge.",
              "a": "Find the Spring Shocks on Redrock in Emberreach. Then Up makes the rover jump."
            },
            {
              "q": "A wall of rock blocks the way to a vault.",
              "a": "Walk into it. Some rock is not rock at all, and crystal walls shatter at a touch."
            },
            {
              "q": "How do I reach the Maelstrom?",
              "a": "Open the crystal gates in The Deep Black with the Sapphire and Amethyst shards; its jump ring leads to the Maelstrom."
            },
            {
              "q": "Something in the Maelstrom cannot be hurt.",
              "a": "The Phantom, magma and tumbling asteroids cannot be hurt at all. Keep moving."
            },
            {
              "q": "The Guardian's seal won't open.",
              "a": "Only the Core's own light opens it. Crack the Heart Eye three times: a plasma bolt or a shield orb does it cleanly, and ramming it works but hurts. Each time it reels away, then comes back faster. The third time its light flies to you, and the seal opens at a touch."
            }
          ]
        },
        {
          "head": "The Felt Egg",
          "hints": [
            {
              "q": "Some say the felt-maker left something behind...",
              "a": "Fly to where the galaxy chart's four corners meet. The chart wraps around, so all four corners are one place, as far from the Core as space goes."
            },
            {
              "q": "I'm there. It's just a knot of asteroids.",
              "a": "Rock is not always rock. Try the knot's south face. And keep a module slot free: if you're full, drop one with O first."
            },
            {
              "q": "Plot me a course.",
              "a": "Fly to the corner of the galaxy chart and come at the knot from below. The two rocks in the middle of its south face are only a picture: fly straight up through them. Inside, press G to pick up the felt egg, then touch the beacon.",
              "sketch": {
                "rows": [
                  "o oooo",
                  "ooo=ooo",
                  " ooX o",
                  "oo   oo",
                  " oo::oo",
                  "  o^^o",
                  "   @"
                ],
                "labels": [
                  { "x": 8, "y": 1, "text": "BEACON" },
                  { "x": 8, "y": 2, "text": "FELT EGG" },
                  { "x": 8, "y": 4, "text": "NOT ROCK" },
                  { "x": 5, "y": 6, "text": "YOU" }
                ]
              }
            }
          ]
        }
      ]
