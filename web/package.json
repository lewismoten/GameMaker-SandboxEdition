{
  "name": "gamemaker-web",
  "private": true,
  "version": "0.1.0",
  "description": "Web port of Recreational Software Designs' GameMaker 3.0: design, play and export games as offline web apps.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check:games": "vite-node ../games/kit/checkGames.ts",
    "typecheck": "tsc --noEmit",
    "format": "cd .. && prettier --write .",
    "format:check": "cd .. && prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
