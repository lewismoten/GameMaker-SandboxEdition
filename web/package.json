{
  "name": "gamemaker-web",
  "private": true,
  "version": "0.1.0",
  "description": "Web port of Recreational Software Designs' GameMaker 3.0: design, play and export games as offline web apps.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test:fast": "GM_FAST_TESTS=1 vitest run",
    "test:slow-list": "vite-node scripts/slowTests.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "check:games": "vite-node ../games/kit/checkGames.ts",
    "dosbox": "vite-node scripts/dosbox.ts",
    "voice": "vite-node scripts/narrate.ts --",
    "voice:all": "vite-node scripts/narrate.ts -- --force",
    "voice:setup": "npm install --prefix ../.narrate --no-save kokoro-js@1.2.1",
    "dosbox:open": "../dosbox/DOSBOX.command",
    "mcp": "vite-node -c scripts/mcp/vite.config.ts scripts/mcp/main.ts --",
    "typecheck": "tsc --noEmit",
    "format": "cd .. && prettier --write .",
    "format:check": "cd .. && prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^22.20.5",
    "@types/ws": "8.18.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.0",
    "vite-node": "3.2.4",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  }
}
