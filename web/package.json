{
  "name": "gamemaker-web",
  "private": true,
  "version": "3.1.0",
  "description": "Web port of Recreational Software Designs' GameMaker 3.0: design, play and export games as offline web apps.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "video:transcript": "vite-node scripts/videoTranscribe.ts",
    "build": "tsc --noEmit && vite build",
    "test:fast": "GM_FAST_TESTS=1 vitest run",
    "test:slow-list": "vite-node scripts/slowTests.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "walk:auto": "vite-node scripts/walkAuto.ts",
    "wayback:inventory": "vite-node scripts/waybackInventory.ts --",
    "wayback:check": "vite-node scripts/waybackCheck.ts --",
    "wayback:save": "vite-node scripts/waybackSave.ts --",
    "agent:usage": "vite-node scripts/agentUsage.ts --",
    "roundtrip": "vite-node scripts/roundTrip.ts",
    "fuzz:files": "vite-node scripts/fuzzFiles.ts --",
    "check:same-bytes": "vite-node scripts/sameBytes.ts --",
    "check:keys": "vite-node ../games/kit/keyAccess.ts --",
    "dast": "vite-node ../games/kit/dast.ts --",
    "replay:log": "vite-node scripts/replayLog.ts",
    "optimize:proof": "vite-node ../games/kit/optimizeProof.ts",
    "check:games": "vite-node ../games/kit/checkGames.ts",
    "release:draft": "vite-node scripts/release/draft.ts",
    "release:cut": "vite-node scripts/release/cut.ts",
    "release:check": "vite-node scripts/release/check.ts",
    "verify:changed": "node ../scripts/verify-changed.mjs",
    "heavy": "node ../scripts/heavy.mjs",
    "editor:touch": "vite-node scripts/editorTouch.ts",
    "check:dialogs": "vite-node scripts/dialogsFit.ts",
    "check:leaks": "bash scripts/leakSweep.sh",
    "check:dialogs:sweep": "vite-node scripts/dialogsSweep.ts",
    "theme:recheck": "vite-node scripts/themeRecheck.ts",
    "check:gestures": "vite-node scripts/touchGestures.ts",
    "check:audio-unlock": "vite-node scripts/audioUnlock.ts",
    "desk:drive": "vite-node scripts/deskDrive.ts",
    "check:error-notice": "vite-node scripts/errorNoticeCheck.ts",
    "editor:shots": "vite-node scripts/editorShots.ts",
    "smoke:engines": "vite-node scripts/smokeEngines.ts",
    "perf:check": "vite-node scripts/perfCheck.ts",
    "perf:trace": "vite-node scripts/perfTrace.ts",
    "perf:memory": "vite-node scripts/perfMemory.ts",
    "perf:tasks": "vite-node scripts/perfTasks.ts",
    "verify:perf": "vite-node scripts/verifyPerf.ts --",
    "disk:diff": "vite-node scripts/diskDiff.ts --",
    "dosbox": "vite-node scripts/dosbox.ts",
    "domains:check": "vite-node scripts/domainsCheck.ts",
    "dead:code": "vite-node scripts/deadCode.ts",
    "tour:check": "vite-node scripts/tourCheck.ts --",
    "tour:audit": "vite-node scripts/tourAudit.ts --",
    "badges:similar": "vite-node scripts/badgeSimilar.ts --",
    "voice": "vite-node scripts/narrate.ts --",
    "voice:all": "vite-node scripts/narrate.ts -- --force",
    "voice:phone": "vite-node scripts/narrate.ts -- --lines phone --out public/phone/voice",
    "voice:phone:check": "vite-node scripts/narrate/verify.ts -- --lines phone --out public/phone/voice",
    "voice:check": "vite-node scripts/narrate/verify.ts --",
    "voice:setup": "npm install --prefix ../.narrate --no-save kokoro-js@1.2.1",
    "dosbox:open": "../dosbox/DOSBOX.command",
    "mcp": "vite-node -c scripts/mcp/vite.config.ts scripts/mcp/main.ts --",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/web.tsbuildinfo",
    "format": "cd .. && prettier --write . --cache --cache-location node_modules/.cache/prettier/.cache --cache-strategy content",
    "format:check": "cd .. && prettier --check . --cache --cache-location node_modules/.cache/prettier/.cache --cache-strategy content",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.cache --cache-strategy content",
    "lint:full": "eslint .",
    "lint:fix": "eslint . --fix",
    "predev": "node ../scripts/dev-games.mjs",
    "prebuild": "node ../scripts/build-games.mjs",
    "pretest": "node ../scripts/build-games.mjs",
    "pretest:fast": "node ../scripts/build-games.mjs",
    "precheck:games": "node ../scripts/build-games.mjs"
  },
  "dependencies": {
    "@lewismoten/gamemaker-sandbox-archives": "3.2.0",
    "@lewismoten/gamemaker-sandbox-engine": "3.3.0",
    "@lewismoten/gamemaker-sandbox-tools": "3.4.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vite-node": "3.2.4"
  }
}
