{
  "name": "@lewismoten/gamemaker-sandbox-archives",
  "version": "3.2.0",
  "description": "Portable game discovery, ZIP/SFX extraction, and ZIP creation for Game-Maker files",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lewismoten/GameMaker-SandboxEdition.git",
    "directory": "web/packages/archives"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "gamemaker-source": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./zip": {
      "types": "./dist/types/project/zip.d.ts",
      "gamemaker-source": "./src/project/zip.ts",
      "import": "./dist/zip.js"
    },
    "./pack": {
      "types": "./dist/types/project/gamePack.d.ts",
      "gamemaker-source": "./src/project/gamePack.ts",
      "import": "./dist/pack.js"
    },
    "./scan": {
      "types": "./dist/types/project/importScan.d.ts",
      "gamemaker-source": "./src/project/importScan.ts",
      "import": "./dist/scan.js"
    },
    "./player/applyPatches": {
      "types": "./dist/types/player/applyPatches.d.ts",
      "gamemaker-source": "./src/player/applyPatches.ts",
      "import": "./dist/player/applyPatches.js"
    },
    "./player/md5": {
      "types": "./dist/types/player/md5.d.ts",
      "gamemaker-source": "./src/player/md5.ts",
      "import": "./dist/player/md5.js"
    },
    "./project/extensionNames": {
      "types": "./dist/types/project/extensionNames.d.ts",
      "gamemaker-source": "./src/project/extensionNames.ts",
      "import": "./dist/project/extensionNames.js"
    },
    "./project/gamePack": {
      "types": "./dist/types/project/gamePack.d.ts",
      "gamemaker-source": "./src/project/gamePack.ts",
      "import": "./dist/pack.js"
    },
    "./project/importLeftovers": {
      "types": "./dist/types/project/importLeftovers.d.ts",
      "gamemaker-source": "./src/project/importLeftovers.ts",
      "import": "./dist/project/importLeftovers.js"
    },
    "./project/importPlayer": {
      "types": "./dist/types/project/importPlayer.d.ts",
      "gamemaker-source": "./src/project/importPlayer.ts",
      "import": "./dist/project/importPlayer.js"
    },
    "./project/importScan": {
      "types": "./dist/types/project/importScan.d.ts",
      "gamemaker-source": "./src/project/importScan.ts",
      "import": "./dist/scan.js"
    },
    "./project/zip": {
      "types": "./dist/types/project/zip.d.ts",
      "gamemaker-source": "./src/project/zip.ts",
      "import": "./dist/zip.js"
    }
  },
  "scripts": {
    "build": "node build.js",
    "prepack": "npm run build",
    "verify": "npm run build && node verify.js"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "@types/node": "^22.20.5"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "dependencies": {
    "@lewismoten/gamemaker-sandbox-engine": "^3.2.0"
  },
  "author": "Lewis Moten"
}
