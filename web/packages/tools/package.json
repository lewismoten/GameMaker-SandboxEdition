      "gamemaker-source": "./src/palettes.ts",
      "import": "./dist/palettes.js"
    }
  },
  "scripts": {
    "build": "node build.js",
    "prepack": "npm run build",
    "verify": "npm run build && node verify.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "dependencies": {
    "@lewismoten/gamemaker-sandbox-engine": "^3.2.0",
    "@lewismoten/gamemaker-sandbox-archives": "^3.2.0"
