{
  "name": "@lewismoten/gamemaker-sandbox-tools",
  "version": "0.1.0",
  "description": "Development tools for building and checking games in RSD Game-Maker formats",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lewismoten/GameMaker-SandboxEdition.git",
    "directory": "web/packages/tools"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "exports": {
    "./formats/*": {
      "types": "./dist/types/web/src/formats/*.d.ts",
      "browser": null,
      "import": "./dist/formats/*.js"
    },
    "./drawing": {
      "types": "./dist/types/web/packages/tools/src/drawing.d.ts",
      "browser": null,
      "import": "./dist/drawing.js"
    },
    "./audio": {
      "types": "./dist/types/web/packages/tools/src/audio.d.ts",
      "browser": null,
      "import": "./dist/audio.js"
    },
    "./images": {
      "types": "./dist/types/web/packages/tools/src/images.d.ts",
      "browser": null,
      "import": "./dist/images.js"
    },
    "./simulation": {
      "types": "./dist/types/web/packages/tools/src/simulation.d.ts",
      "browser": null,
      "import": "./dist/simulation.js"
    }
  },
  "scripts": {
    "build": "node build.js",
    "prepack": "npm run build",
    "verify": "npm run build && node verify.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
