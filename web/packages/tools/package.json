{
  "name": "@lewismoten/gamemaker-sandbox-tools",
  "version": "3.3.0",
  "description": "Development tools for building and checking games in RSD Game-Maker formats",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lewismoten/GameMaker-SandboxEdition.git",
    "directory": "web/packages/tools"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "exports": {
    "./drawing": {
      "types": "./dist/types/drawing.d.ts",
      "browser": null,
      "gamemaker-source": "./src/drawing.ts",
      "import": "./dist/drawing.js"
    },
    "./audio": {
      "types": "./dist/types/audio.d.ts",
      "gamemaker-source": "./src/audio.ts",
      "import": "./dist/audio.js"
    },
    "./images": {
      "types": "./dist/types/images.d.ts",
      "gamemaker-source": "./src/images.ts",
      "import": "./dist/images.js"
    },
    "./simulation": {
      "types": "./dist/types/simulation.d.ts",
      "browser": null,
      "gamemaker-source": "./src/simulation.ts",
      "import": "./dist/simulation.js"
    },
    "./formats/*": {
      "types": "./dist/types/formats/*.d.ts",
      "browser": null,
      "gamemaker-source": "./src/formats/*.ts",
      "import": "./dist/formats/*.js"
    },
    "./kit/*": {
      "types": "./dist/types/kit/*.d.ts",
      "browser": null,
      "gamemaker-source": "./src/kit/*.ts",
      "import": "./dist/kit/*.js"
    },
    "./music/*": {
      "types": "./dist/types/music/*.d.ts",
      "gamemaker-source": "./src/music/*.ts",
      "import": "./dist/music/*.js"
    },
    "./image/*": {
      "types": "./dist/types/image/*.d.ts",
      "gamemaker-source": "./src/image/*.ts",
      "import": "./dist/image/*.js"
    },
    "./audio-files": {
      "types": "./dist/types/audioFiles.d.ts",
      "browser": null,
      "gamemaker-source": "./src/audioFiles.ts",
      "import": "./dist/audio-files.js"
    },
    "./microFont": {
      "types": "./dist/types/microFont.d.ts",
      "gamemaker-source": "./src/microFont.ts",
      "import": "./dist/microFont.js"
    }
  },
  "scripts": {
    "build": "node build.js",
    "prepack": "npm run build",
    "verify": "npm run build && node verify.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "dependencies": {
    "@lewismoten/gamemaker-sandbox-engine": "^3.2.0",
    "@lewismoten/gamemaker-sandbox-archives": "^3.2.0"
  },
  "author": "Lewis Moten"
}
