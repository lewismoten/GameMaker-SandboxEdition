# Prettier formats web/'s code (TypeScript, JavaScript, CSS). Everything else is left as written.
# The original release (../code, ../cd, ../runtime) is preserved as is and never formatted.

# built output and dependencies
dist/
node_modules/
coverage/

# public/ is copied into the site as is: generated data (cast/sprites.json,
# extras/demos.json, bbs/*), the manifest and binary downloads
public/

# generated JSON, rewritten by scripts and game tools (scripts/castHidden.ts,
# scripts/bbsGifs.ts, games/kit/tinHearts.ts, …); keep their bytes as their writers make them
*.json
!/package.json
!/tsconfig.json

# hand-written pages and docs: index.html and play.html are Vite entries (editing them
# reloads open dev pages), and the READMEs are prose with hand-made tables
*.html
*.md

# Pending: vite.config.ts and the files it imports. Writing any of them restarts the dev
# server, which reloads every open page, so these were left unformatted. Format them while
# the dev server is stopped (npx prettier --write <these files>), then delete this block.
/vite.config.ts
/src/eggs/eggs.ts
/src/project/files.ts
/src/formats/graphicScripts.ts
/src/formats/palette.ts
/src/gfx/levelPicture.ts
/src/formats/voc.ts
/src/retro/dos/disks.ts
/src/project/diskFacts.ts
/src/project/bizarre.ts
