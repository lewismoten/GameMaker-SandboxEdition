{
  "name": "gamemaker-sandbox-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "web/packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @lewismoten/gamemaker-sandbox-engine && npm run build -w @lewismoten/gamemaker-sandbox-archives && npm run build -w @lewismoten/gamemaker-sandbox-tools",
    "prepare": "npm run build:packages && npm run build:games",
    "verify:packages": "node scripts/verify-packages.mjs",
    "dev": "npm run dev -w gamemaker-web",
    "start": "npm run dev -w gamemaker-web",
    "build": "npm run build:packages && npm run build -w gamemaker-web",
    "test": "npm run test -w gamemaker-web",
    "typecheck": "npm run typecheck -w gamemaker-web",
    "format": "npm run format -w gamemaker-web",
    "lint": "npm run lint -w gamemaker-web",
    "build:games": "node scripts/build-games.mjs",
    "check:games": "npm run check:games -w gamemaker-web --",
    "optimize:proof": "npm run optimize:proof -w gamemaker-web --",
    "test:fast": "npm run test:fast -w gamemaker-web --",
    "walk:auto": "npm run walk:auto -w gamemaker-web --",
    "domains:check": "npm run domains:check -w gamemaker-web --",
    "badges:similar": "npm run badges:similar -w gamemaker-web --"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
